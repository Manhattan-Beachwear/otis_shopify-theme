                "width": 20
              },
              "blocks": {
                "text_xrAJ6i": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>As prescription lenses are considered a medical item they can’t be returned unless there is a manufacturing issue. OTIS Lifetime Warranty on manufacturing defects of the frame still apply. However if you have a problem please email tlccs@mbwswim.com with your order number and we will happily look after you to make sure you are happy with the outcome.</p>",
                    "width": "100%",
