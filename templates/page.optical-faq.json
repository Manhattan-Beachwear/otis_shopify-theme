            },
            "accordion_row_iPHmzK": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What are progressive lenses?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_qbLWmC": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Progressive lenses are Multifocal lenses with different sections of vision correction. With a seamless transition in the lens from distance on top, to reading correction at the bottom, they can provide much sharper overall vision.</p>",
                    "width": "100%",
                    "max_width": "none",
