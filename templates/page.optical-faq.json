                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_qbLWmC"
              ]
            },
            "accordion_row_7Qx4MJ": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What do Blue Light lenses do?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_MkpWgM": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Blue light glasses filter the blue light emissions from digital devices, artificial light from screens and lights and are used to minimise the impact on your circadian rhythm, which is particularly important for those who spend a lot of time using digital screens or in LED lit rooms. Blue light lenses can help mitigate the impact of blue light by limiting how much reaches the eyes, supporting the natural release of melatonin. Blue light lenses may contribute to improved hormone regulation and alertness.</p><p></p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_MkpWgM"
              ]
            },
            "accordion_row_MptRVH": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What are Transition lenses?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_zyxLVx": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Transition lenses are photochromic that darken outdoors in seconds, and indoors they return to clear faster than ever. They block 100% of UVA and UVB ray and filter up to 26% of blue-violet light indoors and up to 86% of blue-violet light outdoors. They are lenses you can wear all the time in all conditions.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
