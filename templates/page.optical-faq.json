            "accordion_row_CdgqLg": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "How long will it take to get my prescription order?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_BjELd8": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Please note that prescription orders may take 1-3 weeks to process due to the manufacturing time required by our lab. Each pair of glasses is custom-made to ensure the highest quality and accuracy for your prescription. We appreciate your patience and understanding as we work to provide you with the best possible product. If you have any questions or need updates on the status of your order, feel free to reach out to us! <em>This timeframe excludes weekends, public holidays, and peak seasonal closures, which did apply over the Christmas and New Year period.</em></p><p></p>",
                    "width": "100%",
