                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_faq_time"
              ]
            },
            "faq_insurance": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Can I use my vision benefits?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_faq_insurance": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We don’t bill insurers directly. Your emailed invoice is itemized, so you can submit it to your vision plan, FSA or HSA administrator for reimbursement.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
