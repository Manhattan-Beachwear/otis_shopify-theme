    "section_seo": {
      "type": "section",
      "blocks": {
        "text_seo_heading": {
          "type": "text",
          "settings": {
            "text": "<h2>OTIS prescription lenses</h2>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h4",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
