              "type": "_accordion-row",
              "settings": {
                "heading": "What prescriptions can you fill?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_faq_powers": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Single vision and progressive lenses, in standard and high Rx powers. If your script sits outside the range we can make, our customer support team will get in touch before your order goes to the lab.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
