            "faq_send": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How do I send you my prescription?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_faq_send": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Upload a photo or PDF of your script while you build your lenses and we’ll read the values across, or type them in yourself. Ordered without it? Add your prescription any time from <a href=\"/pages/my-orders\" title=\"My orders\">My orders</a>.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_faq_send"
              ]
            },
            "faq_time": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How long does it take?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_faq_time": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Allow 1–3 weeks. Every Rx pair is cut and fitted to your prescription in our lab, so it takes longer than a stock pair.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
