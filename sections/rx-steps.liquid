{%- doc -%}
  Tabbed steps — a row of tabs (icon + label) over a single visible panel that
  pairs copy with an image, plus prev/next arrows.

  Horizon has no tabs of its own, so this reproduces the layout the AU store gets
  from its Section Store "feature" section. The section heading lives outside the
  panels (one <h2> for the whole section, not one per step) and shares a row with
  the arrows above the panel, so heading, copy and tabs all start at the same
  edge. Without JS the first panel stays visible and the tabs simply do nothing.
{%- enddoc -%}

{%- liquid
  assign steps = section.blocks
  assign heading = section.settings.heading

  assign ratio = '1'
  case section.settings.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '16 / 9'
  endcase

  # Emitted only when set: a `color` setting that the merchant cleared renders as
  # an empty token stream, which is a valid custom property value and therefore
  # shadows the var() fallback instead of falling through to it.
  capture inline_style
    echo '--rx-steps-ratio: ' | append: ratio | append: ';'
    if section.settings.tab_active_background != blank
      echo '--rx-steps-tab-active-bg: ' | append: section.settings.tab_active_background | append: ';'
    endif
    if section.settings.tab_active_text != blank
      echo '--rx-steps-tab-active-fg: ' | append: section.settings.tab_active_text | append: ';'
    endif
  endcapture
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if steps.size > 0 -%}
    <rx-steps class="rx-steps" style="{{ inline_style }}">
      <div
        class="rx-steps__tabs"
        role="tablist"
        aria-label="{{ section.settings.tablist_label | default: 'Steps' | escape }}"
        on:keydown="/navigate"
      >
        {%- for block in steps -%}
          <button
            type="button"
            class="rx-steps__tab{% if forloop.first %} rx-steps__tab--active{% endif %}"
            role="tab"
            id="RxStepsTab-{{ section.id }}-{{ block.id }}"
            aria-controls="RxStepsPanel-{{ section.id }}-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            ref="tabs[]"
            on:click="/select?index={{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.icon != 'none' or block.settings.icon_image != blank -%}
              {%- render 'icon-or-image',
                icon: block.settings.icon,
                image_upload: block.settings.icon_image,
                width: section.settings.icon_size,
                class_name: 'rx-steps__tab-icon'
              -%}
            {%- endif -%}
            <span class="rx-steps__tab-label">{{ block.settings.tab_label | escape }}</span>
          </button>
        {%- endfor -%}
      </div>

      <div class="rx-steps__stage">
        {%- if heading != blank -%}
          <div class="rx-steps__heading">{{ heading }}</div>
        {%- endif -%}

        <div class="rx-steps__nav">
          <button
            type="button"
            class="rx-steps__arrow rx-steps__arrow--prev"
            aria-label="{{ 'content.pagination.previous' | t }}"
            on:click="/prev"
          >
            <span class="svg-wrapper icon-caret">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>

          <button
            type="button"
            class="rx-steps__arrow rx-steps__arrow--next"
            aria-label="{{ 'content.pagination.next' | t }}"
            on:click="/next"
          >
            <span class="svg-wrapper icon-caret">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

        <div class="rx-steps__panels">
          {%- for block in steps -%}
            <div
              class="rx-steps__panel"
              role="tabpanel"
              id="RxStepsPanel-{{ section.id }}-{{ block.id }}"
              aria-labelledby="RxStepsTab-{{ section.id }}-{{ block.id }}"
              tabindex="0"
              ref="panels[]"
              {% unless forloop.first %}
                hidden
              {% endunless %}
            >
              <div class="rx-steps__copy">
                {%- if block.settings.heading != blank -%}
                  <h3 class="rx-steps__step-heading">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rx-steps__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>

              <div class="rx-steps__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      width: block.settings.image.width,
                      height: block.settings.image.height,
                      widths: '400, 600, 800, 1000, 1200, 1600',
                      sizes: '(min-width: 1440px) 700px, (min-width: 880px) 45vw, 100vw',
                      loading: 'lazy',
                      class: 'rx-steps__image'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'rx-steps__image rx-steps__image--placeholder' }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </rx-steps>

    <script src="{{ 'rx-steps.js' | asset_url }}" type="module" fetchpriority="low"></script>
  {%- endif -%}
</div>

{% stylesheet %}
  .rx-steps {
    /* Gap between the copy and media columns; the heading and the arrows sit on
       the same two tracks, so the whole stage lines up with the tab row. */
    --rx-steps-gap: var(--gap-3xl);
    --rx-steps-ratio: 1;
    --rx-steps-tab-active-bg: var(--color-foreground);
    --rx-steps-tab-active-fg: var(--color-background);
    --rx-steps-arrow-size: var(--slideshow-controls-size);
    --rx-steps-arrow-icon: var(--slideshow-controls-icon);

    display: block;
  }

  /* Tabs */

  /* Tracks rather than auto-columns: five or six steps wrap onto a second row
     instead of squeezing every label. */
  .rx-steps__tabs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: var(--gap-3xs);
  }

  .rx-steps__tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-xs);
    min-height: var(--minimum-touch-target);
    padding: var(--padding-sm) var(--padding-md);
    border: none;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: var(--font-size--xs);
    font-weight: 700;
    letter-spacing: var(--letter-spacing-sm);
    text-align: center;
    text-transform: uppercase;
    cursor: pointer;
  }

  .rx-steps__tab:hover {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  /* Also matched with :hover so a sticky hover state after a tap on touch
     devices cannot out-specify the accent fill. */
  .rx-steps__tab--active,
  .rx-steps__tab--active:hover {
    background-color: var(--rx-steps-tab-active-bg);
    color: var(--rx-steps-tab-active-fg);
  }

  .rx-steps__tab-icon {
    flex-shrink: 0;
  }

  /* A flex item sizes to its longest word by default, which pushes a label like
     "Prescription" straight out of a narrow tab. */
  .rx-steps__tab-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* Stage: heading and arrows share the top row, panel spans both columns below,
     so heading, copy and tabs all start at the page-width edge. */

  .rx-steps__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--rx-steps-gap);
    row-gap: var(--margin-4xl);
    margin-block-start: var(--margin-5xl);
  }

  .rx-steps__heading {
    grid-row: 1;
    grid-column: 1;
    align-self: end;
    max-width: var(--max-width--heading-normal);
  }

  /* Size and weight carry the contrast with the step heading below; case and
     tracking stay on the theme's h2 so this reads like every other h2 on the page. */
  .rx-steps__heading > * {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--font-size--2xl);
    font-weight: var(--font-h2--weight);
    line-height: var(--line-height--display-loose);
    letter-spacing: var(--font-h2--letter-spacing);
    text-transform: var(--font-h2--case);
    text-wrap: pretty;
  }

  .rx-steps__panels {
    grid-row: 2;
    grid-column: 1 / 3;
  }

  /* Top-aligned so the step heading reads as the next line of the copy column,
     right under the section heading, instead of floating against the image.
     Auto-fit instead of a breakpoint: the pair splits only while both columns
     hold 24rem, so the tablet band gets full-width copy rather than a ribbon. */
  .rx-steps__panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr));
    align-items: start;
    gap: var(--gap-2xl) var(--rx-steps-gap);
  }

  .rx-steps__panel[hidden] {
    display: none;
  }

  .rx-steps__step-heading {
    margin: 0 0 var(--margin-2xl);
    font-family: var(--font-heading--family);
    font-size: var(--font-size--3xl);
    font-weight: 700;
    line-height: var(--line-height--display-tight);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .rx-steps__text {
    max-width: var(--max-width--body-normal);
  }

  .rx-steps__text > :first-child {
    margin-block-start: 0;
  }

  .rx-steps__text > :last-child {
    margin-block-end: 0;
  }

  .rx-steps__image {
    display: block;
    width: 100%;
    aspect-ratio: var(--rx-steps-ratio);
    object-fit: cover;
  }

  .rx-steps__image--placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  /* Arrows */

  .rx-steps__nav {
    grid-row: 1;
    grid-column: 2;
    align-self: end;
    justify-self: end;
    display: flex;
    gap: var(--gap-lg);
  }

  .rx-steps__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--rx-steps-arrow-size);
    height: var(--rx-steps-arrow-size);
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: var(--color-background);
    color: var(--color-foreground);
    box-shadow: 0 2px 12px rgb(var(--color-shadow-rgb) / var(--opacity-20));
    cursor: pointer;
  }

  .rx-steps__arrow:hover,
  .rx-steps__arrow:focus-visible {
    box-shadow: 0 4px 18px rgb(var(--color-shadow-rgb) / var(--opacity-30));
  }

  /* The chevron is a stroke asset, so the stroke thins out as the box grows —
     1px at 2rem lands on the same visual weight the theme's large arrows use,
     and holding it there keeps the mobile chevron from looking heavier. */
  .rx-steps__arrow .svg-wrapper,
  .rx-steps__arrow .svg-wrapper > svg {
    --icon-stroke-width: 1px;

    width: var(--rx-steps-arrow-icon);
    height: var(--rx-steps-arrow-icon);
  }

  /* icon-caret.svg points down; turn it toward the travel direction. */
  .rx-steps__arrow--prev .svg-wrapper {
    rotate: 90deg;
  }

  .rx-steps__arrow--next .svg-wrapper {
    rotate: -90deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rx-steps__tab {
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .rx-steps__arrow {
      transition: box-shadow 0.2s ease, scale 0.2s ease;
    }

    .rx-steps__arrow:hover {
      scale: 1.04;
    }
  }

  /* Below the theme's spacing-scale breakpoint the panel is one column for most
     of the band, so the step heading comes down a step with it. */
  @media screen and (max-width: 989px) {
    .rx-steps {
      --rx-steps-gap: var(--gap-2xl);
    }

    .rx-steps__step-heading {
      font-size: var(--font-size--2xl);
    }
  }

  @media screen and (max-width: 749px) {
    .rx-steps {
      /* Smaller, but still well clear of the 44px touch target. */
      --rx-steps-arrow-size: 3rem;
      --rx-steps-arrow-icon: 1.5rem;
    }

    /* Two rows of two — every tab stays reachable without a horizontal scroller. */
    .rx-steps__tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rx-steps__tab {
      flex-direction: column;
      gap: var(--gap-2xs);
      padding: var(--padding-md) var(--padding-sm);
      font-size: var(--font-size--2xs);
    }

    .rx-steps__stage {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--margin-2xl);
      margin-block-start: var(--margin-4xl);
    }

    .rx-steps__heading {
      grid-column: 1;
    }

    .rx-steps__heading > * {
      font-size: var(--font-size--xl);
    }

    .rx-steps__panels {
      grid-column: 1;
    }

    .rx-steps__step-heading {
      margin-block-end: var(--margin-lg);
    }

    /* Arrows drop below the panel rather than crowding the heading. */
    .rx-steps__nav {
      grid-row: 3;
      grid-column: 1;
      justify-self: stretch;
      justify-content: space-between;
      margin-block-start: var(--margin-xs);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rx steps",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>How to order OTIS Rx online</h2>"
    },
    {
      "type": "text",
      "id": "tablist_label",
      "label": "Tab list label",
      "info": "Read out by screen readers before the tabs.",
      "default": "Ordering steps"
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "tab_active_background",
      "label": "Active tab background",
      "default": "#fbb163"
    },
    {
      "type": "color",
      "id": "tab_active_text",
      "label": "Active tab text",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Step one"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "award", "label": "Award" },
            { "value": "box", "label": "Box" },
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "check_box", "label": "Check box" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "eye", "label": "Eye" },
            { "value": "globe", "label": "Globe" },
            { "value": "heart", "label": "Heart" },
            { "value": "lock", "label": "Lock" },
            { "value": "map_pin", "label": "Map pin" },
            { "value": "plane", "label": "Plane" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "question_mark", "label": "Question mark" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "star", "label": "Star" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "clipboard"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image",
          "info": "Replaces the icon above."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Step one"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Rx steps",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
